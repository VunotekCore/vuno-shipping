{
  "name": "mg-shipping-agency",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:api": "php -S localhost:8000 -t api",
    "dev:backoffice": "cd backoffice && npm run dev",
    "dev:all": "concurrently -n api,backoffice,astro -c blue,green,magenta \"pnpm dev:api\" \"pnpm dev:backoffice\" \"pnpm dev\"",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/material-symbols": "^1.2.87",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.8",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "concurrently": "^10.0.4",
    "typescript": "^6.0.3"
  }
}