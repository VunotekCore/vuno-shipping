# ============================================================
# Shipping Agency — Variables de entorno
# Copiá este archivo como .env y completá los valores
# cp .env.example .env
# ============================================================

# === Frontend (Astro) ===
PUBLIC_SITE_URL=https://shipping.vunotek.com
PUBLIC_API_URL=https://shipping.vunotek.com/api

# === Backend PHP ===

# --- Database (Hostinger) ---
DB_HOST=localhost
DB_NAME=vuno_db_shipping
DB_USER=shipping_user
DB_PASS=TU_PASSWORD_AQUI
DB_CHARSET=utf8mb4

# --- JWT ---
# Generar con: openssl rand -hex 32
JWT_SECRET=GENERAR_CON_openssl_rand_hex_32
JWT_EXPIRES_IN=86400
JWT_ISSUER=shipping.vunotek.com

# --- CORS (origins permitidos, separados por coma) ---
CORS_ALLOWED_ORIGINS=https://shipping.vunotek.com,http://localhost:4321,http://localhost:5173

# --- App ---
APP_DEBUG=false
APP_TIMEZONE=America/Managua
