---
export interface Props {
  activePage?: "home" | "servicios" | "contacto";
}
const { activePage = "home" } = Astro.props;
const links = [
  { href: "/", label: "Home", id: "home" },
  { href: "/servicios", label: "Services", id: "servicios" },
  { href: "/contacto", label: "Contact", id: "contacto" },
];
---

<nav
  class="fixed top-0 left-0 w-full z-50 h-20 bg-surface shadow-sm transition-all duration-300"
  id="main-nav"
>
  <div id="scroll-progress" class="progress-bar"></div>
  <div
    class="flex justify-between items-center h-full max-w-container-max mx-auto px-margin-mobile md:px-sp-lg"
  >
    <div class="flex items-center gap-base">
      <a
        href="/"
        class="text-headline-md font-headline-md font-bold text-primary no-underline logo-animate"
        >Mg Shipping Agency</a
      >
    </div>
    <div class="hidden md:flex items-center gap-sp-lg">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={`nav-link text-label-md font-label-md no-underline pb-1 transition-colors duration-200 ${
              activePage === link.id
                ? "text-primary font-bold nav-link-active"
                : "text-on-surface-variant hover:text-secondary"
            }`}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="hidden sm:flex items-center gap-sp-sm">
      <button
        class="text-primary font-label-md hover:text-secondary transition-colors cursor-pointer whitespace-nowrap"
        >Sign In</button
      >
      <button
        class="bg-primary text-on-primary px-sp-md py-sp-xs rounded-lg font-label-md hover:bg-primary-container hover:text-on-primary-container transition-all active:scale-95 cursor-pointer whitespace-nowrap"
        >Open Locker</button
      >
    </div>
  </div>
</nav>

<style>
  @keyframes logoEntrance {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .logo-animate {
    animation: logoEntrance 0.8s ease-out forwards;
  }

  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 100%;
    height: 2px;
    background: var(--color-primary);
    transform: translateX(-50%) scaleX(0);
    transition: transform 0.3s ease;
  }

  .nav-link:hover::after {
    transform: translateX(-50%) scaleX(1);
  }

  .nav-link-active::after {
    transform: translateX(-50%) scaleX(1);
  }

  .progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--color-primary);
    width: 0%;
    transition: width 0.1s linear;
    z-index: 60;
    pointer-events: none;
  }
</style>

<script>
  const nav = document.getElementById("main-nav");
  const progressBar = document.getElementById("scroll-progress");

  window.addEventListener("scroll", () => {
    if (!nav) return;

    if (window.scrollY > 50) {
      nav.classList.add("h-16", "shadow-md", "bg-surface/95", "backdrop-blur-sm");
      nav.classList.remove("h-20", "shadow-sm", "bg-surface");
    } else {
      nav.classList.add("h-20", "shadow-sm", "bg-surface");
      nav.classList.remove("h-16", "shadow-md", "bg-surface/95", "backdrop-blur-sm");
    }

    if (progressBar) {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const percent = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
      progressBar.style.width = percent + "%";
    }
  });
</script>
