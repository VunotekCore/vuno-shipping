---
interface Props {
  name: string;
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const {
  name,
  class: className = '',
  size = 'md',
} = Astro.props;

const sizes: Record<string, string> = {
  sm: 'w-4 h-4',
  md: 'w-6 h-6',
  lg: 'w-8 h-8',
};

import { iconPaths } from '../../lib/icons';

const pathData = iconPaths[name] ?? iconPaths['check'];
---

<svg class:list={[sizes[size], 'fill-current', className]} viewBox="0 0 24 24">
  <path d={pathData} />
</svg>
