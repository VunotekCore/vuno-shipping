---
interface Props {
  type?: 'text' | 'email' | 'tel' | 'number' | 'password';
  name?: string;
  id?: string;
  placeholder?: string;
  value?: string;
  required?: boolean;
  disabled?: boolean;
  min?: string;
  max?: string;
  step?: string;
  'aria-label'?: string;
  autocomplete?: string;
  class?: string;
}

const {
  type = 'text',
  name,
  id,
  placeholder,
  value,
  required = false,
  disabled = false,
  min,
  max,
  step,
  'aria-label': ariaLabel,
  autocomplete,
  class: className = '',
} = Astro.props;

const base = 'w-full px-sp-md py-base rounded-lg border border-outline-variant bg-white text-primary text-body-md focus:ring-2 focus:ring-primary-container focus:outline-none transition-all';
---

<input
  type={type}
  name={name}
  id={id}
  placeholder={placeholder}
  value={value}
  required={required}
  disabled={disabled}
  min={min}
  max={max}
  step={step}
  aria-label={ariaLabel}
  autocomplete={autocomplete}
  class={`${base} ${className}`}
/>
