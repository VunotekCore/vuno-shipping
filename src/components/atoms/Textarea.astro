---
interface Props {
  name?: string;
  id?: string;
  placeholder?: string;
  rows?: number;
  required?: boolean;
  class?: string;
}

const {
  name,
  id,
  placeholder,
  rows = 4,
  required = false,
  class: className = '',
} = Astro.props;

const base = 'w-full px-sp-md py-base rounded-lg border border-outline-variant bg-white text-primary text-body-md focus:ring-2 focus:ring-primary-container focus:outline-none transition-all resize-none';
---

<textarea
  name={name}
  id={id}
  placeholder={placeholder}
  rows={rows}
  required={required}
  class={`${base} ${className}`}
></textarea>
