<header class="relative pt-20 overflow-hidden">
  <div class="hero-gradient min-h-[870px] flex items-center px-margin-mobile md:px-sp-xl">
    <div class="max-w-container-max mx-auto w-full grid grid-cols-1 md:grid-cols-2 items-center gap-sp-lg">
      <div class="text-on-primary space-y-sp-md">
        <h1 class="font-display-lg text-display-lg md:text-display-lg max-w-xl leading-tight">Tus compras en USA, entregadas en la puerta de tu casa en Nicaragua.</h1>
        <p class="text-body-lg font-body-lg text-surface-variant max-w-md">La forma más rápida, segura y confiable de traer tus paquetes desde Miami hasta cualquier parte de Nicaragua.</p>
        <div class="flex flex-col sm:flex-row gap-sp-md pt-base">
          <button class="bg-secondary-container text-on-secondary-container px-sp-lg py-sp-md rounded-xl font-headline-md text-headline-md shadow-lg hover:translate-y-[-2px] transition-transform cursor-pointer">Abrir Casillero Gratis</button>
          <button class="border-2 border-on-primary text-on-primary px-sp-lg py-sp-md rounded-xl font-headline-md text-headline-md hover:bg-on-primary hover:text-primary transition-all flex items-center justify-center gap-sp-xs cursor-pointer">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M6 22q-.825 0-1.412-.587Q4 20.825 4 20V8q0-.825.588-1.412Q5.175 6 6 6h3V4q0-.825.588-1.413Q10.175 2 11 2h2q.825 0 1.413.587Q15 3.175 15 4v2h3q.825 0 1.413.588Q20 7.175 20 8v12q0 .825-.587 1.413Q18.825 22 18 22Zm0-2h12V8h-3v2q0 .425-.287.712Q14.425 11 14 11h-4q-.425 0-.712-.288Q9 10.425 9 10V8H6v12Zm5-12h2V4h-2Zm-5 12V8v12Z"/></svg>
            Rastrear Paquete
          </button>
        </div>
      </div>
      <div class="hidden md:block">
        <div class="bg-surface/10 backdrop-blur-md p-sp-lg rounded-xl border border-white/20 shadow-2xl">
          <h3 class="text-on-primary font-headline-md text-headline-md mb-sp-md">Calculadora de Envío</h3>
          <div class="space-y-sp-sm">
            <div>
              <label class="text-label-sm font-label-sm text-surface-variant block mb-sp-xs">Peso (Lbs)</label>
              <input class="w-full bg-white text-primary px-sp-md py-base rounded-lg border-none focus:ring-2 focus:ring-secondary-container" placeholder="0.00" type="number" />
            </div>
            <div>
              <label class="text-label-sm font-label-sm text-surface-variant block mb-sp-xs">Tipo de Artículo</label>
              <select class="w-full bg-white text-primary px-sp-md py-base rounded-lg border-none focus:ring-2 focus:ring-secondary-container">
                <option>Ropa y Calzado</option>
                <option>Electrónicos</option>
                <option>Hogar</option>
              </select>
            </div>
            <button class="w-full bg-primary text-on-primary py-base rounded-lg font-label-md mt-sp-md cursor-pointer">Calcular Tarifa</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
