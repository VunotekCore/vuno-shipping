---
import ScrollReveal from '../ui/ScrollReveal.astro';

const steps = [
  {
    number: 'PASO 01',
    icon: 'shopping_cart',
    title: 'Compra en tus tiendas favoritas',
    desc: 'Amazon, eBay, Shein o cualquier tienda en USA. Al finalizar tu compra, usa tu dirección de casillero Mg Shipping.'
  },
  {
    number: 'PASO 02',
    icon: 'warehouse',
    title: 'Envía a nuestro almacén en Miami',
    desc: 'Recibimos tus paquetes, los procesamos con cuidado y te notificamos de inmediato en tu panel de usuario.'
  },
  {
    number: 'PASO 03',
    icon: 'door_front',
    title: 'Recibe en tu puerta',
    desc: 'Consolidamos y despachamos hacia Nicaragua. Disfruta de la comodidad de la entrega a domicilio en todo el país.'
  }
];

const iconPaths: Record<string, string> = {
  shopping_cart: 'M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2zM7.17 15.75l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.86-7.01L19.42 4h-.01l-1.1 2-2.76 5H8.53l-.13-.27L6.16 6l-.95-2-.94-2H1v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25z',
  warehouse: 'M22 21V7l-10-5L2 7v14h7v-8h6v8h7zm-9-5v-4H9v4H7v-6h10v6h-4z',
  door_front: 'M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-4 12h-2v-2h2v2z'
};
---

<section class="py-sp-xl px-margin-mobile md:px-sp-xl bg-surface-container-low">
  <div class="max-w-container-max mx-auto">
    <div class="text-center mb-sp-lg">
      <h2 class="font-headline-lg text-headline-lg text-primary mb-sp-base">¿Cómo funciona?</h2>
      <p class="text-on-surface-variant font-body-lg max-w-2xl mx-auto">Importar de Estados Unidos a Nicaragua nunca fue tan sencillo. Sigue estos tres pasos.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-sp-lg relative">
      <div class="hidden md:block absolute top-1/2 left-0 w-full h-0.5 bg-secondary/20 -translate-y-1/2 z-0"></div>
      {
        steps.map((step) => (
          <ScrollReveal>
            <div class="relative z-10 bg-surface-container-lowest p-sp-lg rounded-xl shadow-sm border border-outline-variant hover:shadow-md transition-shadow group text-center">
              <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-sp-md group-hover:bg-secondary transition-colors">
                <svg class="w-8 h-8 fill-white" viewBox="0 0 24 24"><path d={iconPaths[step.icon]} /></svg>
              </div>
              <span class="text-secondary font-bold text-label-md mb-sp-xs block">{step.number}</span>
              <h4 class="font-headline-md text-headline-md text-primary mb-sp-sm">{step.title}</h4>
              <p class="text-on-surface-variant">{step.desc}</p>
            </div>
          </ScrollReveal>
        ))
      }
    </div>
  </div>
</section>
