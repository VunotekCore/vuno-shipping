---
import ScrollReveal from '../ui/ScrollReveal.astro';
---

<section class="py-sp-xl px-margin-mobile md:px-sp-xl">
  <div class="max-w-container-max mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-sp-md">
      <ScrollReveal class="md:col-span-2 md:row-span-2">
        <div class="h-full bg-primary-container rounded-xl p-sp-lg overflow-hidden relative min-h-[400px]">
          <div class="relative z-10">
            <span class="bg-secondary-container text-on-secondary-container px-base py-sp-xs rounded-full text-label-sm font-label-sm mb-sp-md inline-block">Nuestra Sede</span>
            <h3 class="text-on-primary-container font-display-lg text-headline-lg mb-sp-sm">Warehouse Propio en Miami</h3>
            <p class="text-on-primary-container/80 text-body-lg">Control total de tu mercancía desde que llega a nuestras manos hasta que sale hacia su destino final.</p>
          </div>
          <div class="absolute bottom-0 right-0 w-3/4 translate-x-1/4 translate-y-1/4">
            <img class="rounded-tl-2xl shadow-2xl" src="https://lh3.googleusercontent.com/aida-public/AB6AXuChAr7dYqSTSi6O607vv84aOV0_qc-OPfUT_xlAMdzhVsJqa_nYo3IJmGW8ZGBscbkCAhjgsnSgcMDkcRK5XRfE5Yn_gZjOaPixoZ49veYPjPEp-GywQPKzv4sLhggRILbqufG8SQCfAyx1jw-s8ZZzZtwnupsr-N-z6-3cAg5Nwh6jg6-vSdfwt6HW00OH3tNejbx0CONgfS344WRA_1eIULTe5a4vumZhinck_UZECNJhzbx59Tc_LOK6SDpeigu6o0dGYtwf7Pc" alt="Warehouse en Miami" />
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal class="md:col-span-2">
        <div class="bg-white border border-outline-variant rounded-xl p-sp-lg flex items-center gap-sp-lg h-full">
          <div class="w-20 h-20 bg-surface-container-high rounded-xl flex items-center justify-center shrink-0">
            <svg class="w-9 h-9 fill-primary" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2zm-8 4H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2z"/></svg>
          </div>
          <div>
            <h4 class="font-headline-md text-headline-md text-primary mb-sp-xs">Despachos Diarios</h4>
            <p class="text-on-surface-variant">No esperes semanas. Salidas constantes aéreas y marítimas para que tus compras lleguen volando.</p>
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal class="md:col-start-3">
        <div class="h-full bg-surface-container-highest rounded-xl p-sp-lg flex flex-col justify-center">
          <svg class="w-8 h-8 fill-secondary mb-sp-sm" viewBox="0 0 24 24"><path d="M20.94 11A8.994 8.994 0 0013 3.06V1h-2v2.06c-1.13.12-2.19.46-3.16.97l1.5 1.5A6.995 6.995 0 0112 5c3.87 0 7 3.13 7 7 0 1.13-.27 2.2-.78 3.16l1.5 1.5A8.98 8.98 0 0020.94 11zM3 4.27l2.04 2.04A8.914 8.914 0 003.06 11H1v2h2.06c.12 1.13.46 2.19.97 3.16l-1.5 1.5A8.98 8.98 0 001.06 13H3v-2h-.94c.12-1.13.46-2.19.97-3.16L4.54 7.5 6.96 9.92A6.995 6.995 0 005 12c0 3.87 3.13 7 7 7 1.13 0 2.2-.27 3.16-.78l1.5 1.5A8.98 8.98 0 0113 20.94V23h-2v-2.06A8.994 8.994 0 013.06 13H1v-2h2.06c.12-1.13.46-2.19.97-3.16L3 4.27m14.38 6.49A6.828 6.828 0 0013 7.62v2.05a4.98 4.98 0 012.32 2.32l2.06 2.07zM12 5c-1.13 0-2.2.27-3.16.78l1.5 1.5A4.98 4.98 0 0112 7c2.76 0 5 2.24 5 5 0 1.13-.27 2.2-.78 3.16l1.5 1.5A6.98 6.98 0 0019 12c0-3.87-3.13-7-7-7z"/></svg>
          <h4 class="font-headline-md text-headline-md text-primary mb-sp-xs">Rastreo Online</h4>
          <p class="text-on-surface-variant text-label-md">Sigue tu paquete en tiempo real 24/7 desde nuestra app.</p>
        </div>
      </ScrollReveal>

      <ScrollReveal class="md:col-start-4">
        <div class="h-full bg-primary text-on-primary rounded-xl p-sp-lg flex flex-col justify-center">
          <svg class="w-8 h-8 fill-white mb-sp-sm" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          <h4 class="font-headline-md text-headline-md mb-sp-xs">Entrega a Domicilio</h4>
          <p class="text-on-primary/70 text-label-md">Entregamos en la puerta de tu casa u oficina en toda Nicaragua.</p>
        </div>
      </ScrollReveal>
    </div>
  </div>
</section>
