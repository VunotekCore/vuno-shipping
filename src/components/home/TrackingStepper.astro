---
import ScrollReveal from '../ui/ScrollReveal.astro';

const steps = [
  { icon: 'inventory', label: 'Recibido en Miami', active: true, filled: true },
  { icon: 'history_edu', label: 'Aduana Nicaragua', active: false, filled: false },
  { icon: 'local_shipping', label: 'En Ruta de Entrega', active: false, filled: false },
  { icon: 'check_circle', label: 'Entregado', active: false, filled: false }
];

const iconPaths: Record<string, string> = {
  inventory: 'M17 4V2H7v2H2v7c0 1.1.9 2 2 2h3.1c.28 1.14 1.3 2 2.6 2h2.6c1.3 0 2.32-.86 2.6-2H20c1.1 0 2-.9 2-2V4h-5zM7 6h10v3H7V6zm12 5h-3.1c-.28-1.14-1.3-2-2.6-2h-2.6c-1.3 0-2.32.86-2.6 2H5V6h2v3h10V6h2v5z',
  history_edu: 'M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z',
  local_shipping: 'M6 22q-1.05 0-1.775-.725Q3.5 20.55 3.5 19.5H2V3q0-.825.588-1.413Q3.175 1 4 1h11q.825 0 1.413.587Q17 2.175 17 3v3h3l3 4v9h-1.5q0 1.05-.725 1.775Q19.05 22 18 22q-1.05 0-1.775-.725Q15.5 20.55 15.5 19.5h-5q0 1.05-.725 1.775Q9.05 22 8 22q-1.05 0-1.775-.725Q5.5 20.55 5.5 19.5H5v-2h12v-7H5V5h9V3H4v14.025q.45-.275.95-.4Q5.45 16.5 6 16.5q1.05 0 1.775.725Q8.5 17.95 8.5 19q0 .425-.15.825-.15.4-.35.675.2.275.35.675.15.4.15.825 0 .45-.15.825-.15.375-.35.675.2.275.35.675.15.4.15.825 0 1.05-.725 1.775Q7.05 22 6 22Zm0-2q.425 0 .712-.288Q7 19.425 7 19t-.288-.712Q6.425 18 6 18t-.712.288Q5 18.575 5 19t.288.712Q5.575 20 6 20Zm12 0q.425 0 .712-.288Q19 19.425 19 19t-.288-.712Q18.425 18 18 18t-.712.288Q17 18.575 17 19t.288.712Q17.575 20 18 20ZM5 13h12V5H5v8Zm0 0V5v8Z',
  check_circle: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z'
};
---

<section class="py-sp-lg px-margin-mobile md:px-sp-xl bg-white border-y border-outline-variant">
  <ScrollReveal>
    <div class="max-w-container-max mx-auto overflow-x-auto">
      <div class="flex items-center justify-between min-w-[800px] py-sp-md">
        {
          steps.map((step, i) => (
            <>
              <div class="flex flex-col items-center gap-base">
                <div class={`w-12 h-12 rounded-full flex items-center justify-center ${step.active ? 'bg-secondary-container' : 'border-2 border-outline-variant'}`}>
                  <svg class={`w-6 h-6 ${step.active ? 'fill-on-secondary-container' : 'fill-outline'}`} viewBox="0 0 24 24"><path d={iconPaths[step.icon]} /></svg>
                </div>
                <span class={`text-label-md font-bold ${step.active ? 'text-primary' : 'text-on-surface-variant'}`}>{step.label}</span>
              </div>
              {i < steps.length - 1 && (
                <div class={`flex-1 h-1 mx-sp-base relative ${step.active ? 'bg-secondary-container' : 'bg-outline-variant'}`}>
                  {step.active && (
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                      <svg class="w-4 h-4 fill-secondary-container" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
                    </div>
                  )}
                </div>
              )}
            </>
          ))
        }
      </div>
    </div>
  </ScrollReveal>
</section>
