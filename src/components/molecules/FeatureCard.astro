---
import ScrollReveal from '../atoms/ScrollReveal.astro';
import Icon from '../atoms/Icon.astro';

interface Props {
  icon: string;
  title: string;
  description: string;
  badge?: string;
  variant?: 'default' | 'highlighted' | 'primary';
  class?: string;
}

const { icon, title, description, badge, variant = 'default', class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  default: 'bg-white border border-outline-variant',
  highlighted: 'bg-surface-container-highest',
  primary: 'bg-primary text-on-primary',
};

const iconFills: Record<string, string> = {
  default: 'fill-primary',
  highlighted: 'fill-secondary',
  primary: 'fill-white',
};
---

<ScrollReveal class={className}>
  <article class:list={['h-full rounded-xl p-sp-lg flex flex-col justify-center', variants[variant]]}>
    <Icon name={icon} size="lg" class:list={['mb-sp-sm', iconFills[variant]]} />
    {badge && (
      <span class:list={[
        'text-label-sm font-label-sm mb-sp-xs block',
        variant === 'primary' ? 'text-on-primary/70' : 'text-secondary font-bold'
      ]}>
        {badge}
      </span>
    )}
    <h4 class:list={[
      'font-headline-md text-headline-md mb-sp-xs',
      variant === 'primary' ? '' : 'text-primary'
    ]}>
      {title}
    </h4>
    <p class:list={[
      'text-label-md',
      variant === 'primary' ? 'text-on-primary/70' : 'text-on-surface-variant'
    ]}>
      {description}
    </p>
  </article>
</ScrollReveal>
