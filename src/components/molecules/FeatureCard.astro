---
import ScrollReveal from '../atoms/ScrollReveal.astro';

interface Props {
  icon: string;
  title: string;
  description: string;
  badge?: string;
  variant?: 'default' | 'highlighted' | 'primary';
  class?: string;
}

const { icon, title, description, badge, variant = 'default', class: className = '' } = Astro.props;

const variants: Record<string, string> = {
  default: 'bg-white border border-outline-variant',
  highlighted: 'bg-surface-container-highest',
  primary: 'bg-primary text-on-primary',
};

const iconFills: Record<string, string> = {
  default: 'fill-primary',
  highlighted: 'fill-secondary',
  primary: 'fill-white',
};

const iconPaths: Record<string, string> = {
  refresh: 'M20.94 11A8.994 8.994 0 0013 3.06V1h-2v2.06c-1.13.12-2.19.46-3.16.97l1.5 1.5A6.995 6.995 0 0112 5c3.87 0 7 3.13 7 7 0 1.13-.27 2.2-.78 3.16l1.5 1.5A8.98 8.98 0 0020.94 11zM3 4.27l2.04 2.04A8.914 8.914 0 003.06 11H1v2h2.06c.12 1.13.46 2.19.97 3.16l-1.5 1.5A8.98 8.98 0 001.06 13H3v-2h-.94c.12-1.13.46-2.19.97-3.16L4.54 7.5 6.96 9.92A6.995 6.995 0 005 12c0 3.87 3.13 7 7 7 1.13 0 2.2-.27 3.16-.78l1.5 1.5A8.98 8.98 0 0113 20.94V23h-2v-2.06A8.994 8.994 0 013.06 13H1v-2h2.06c.12-1.13.46-2.19.97-3.16L3 4.27m14.38 6.49A6.828 6.828 0 0013 7.62v2.05a4.98 4.98 0 012.32 2.32l2.06 2.07zM12 5c-1.13 0-2.2.27-3.16.78l1.5 1.5A4.98 4.98 0 0112 7c2.76 0 5 2.24 5 5 0 1.13-.27 2.2-.78 3.16l1.5 1.5A6.98 6.98 0 0019 12c0-3.87-3.13-7-7-7z',
  location: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z',
  truck: 'M6 22q-1.05 0-1.775-.725Q3.5 20.55 3.5 19.5H2V3q0-.825.588-1.413Q3.175 1 4 1h11q.825 0 1.413.587Q17 2.175 17 3v3h3l3 4v9h-1.5q0 1.05-.725 1.775Q19.05 22 18 22q-1.05 0-1.775-.725Q15.5 20.55 15.5 19.5h-5q0 1.05-.725 1.775Q9.05 22 8 22q-1.05 0-1.775-.725Q5.5 20.55 5.5 19.5H5v-2h12v-7H5V5h9V3H4v14.025q.45-.275.95-.4Q5.45 16.5 6 16.5q1.05 0 1.775.725Q8.5 17.95 8.5 19q0 .425-.15.825-.15.4-.35.675.2.275.35.675.15.4.15.825 0 .45-.15.825-.15.375-.35.675.2.275.35.675.15.4.15.825 0 1.05-.725 1.775Q7.05 22 6 22Z',
  warehouse: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z',
};

const pathData = iconPaths[icon] ?? iconPaths['warehouse'];
---

<ScrollReveal class={className}>
  <article class:list={['h-full rounded-xl p-sp-lg flex flex-col justify-center', variants[variant]]}>
    <svg class:list={['w-8 h-8 mb-sp-sm', iconFills[variant]]} viewBox="0 0 24 24">
      <path d={pathData} />
    </svg>
    {badge && (
      <span class:list={[
        'text-label-sm font-label-sm mb-sp-xs block',
        variant === 'primary' ? 'text-on-primary/70' : 'text-secondary font-bold'
      ]}>
        {badge}
      </span>
    )}
    <h4 class:list={[
      'font-headline-md text-headline-md mb-sp-xs',
      variant === 'primary' ? '' : 'text-primary'
    ]}>
      {title}
    </h4>
    <p class:list={[
      'text-label-md',
      variant === 'primary' ? 'text-on-primary/70' : 'text-on-surface-variant'
    ]}>
      {description}
    </p>
  </article>
</ScrollReveal>
