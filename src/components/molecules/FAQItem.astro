---
import Icon from '../atoms/Icon.astro';

interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<details class="group border border-outline-variant rounded-xl overflow-hidden">
  <summary class="flex items-center justify-between p-sp-md cursor-pointer list-none bg-white hover:bg-surface-container-low transition-colors">
    <h3 class="font-headline-md text-headline-md text-primary pr-sp-sm">{question}</h3>
    <Icon name="chevron_down" size="sm" class="fill-outline shrink-0 transition-transform duration-300 group-open:rotate-180" />
  </summary>
  <div class="px-sp-md pb-sp-md text-on-surface-variant">
    <p>{answer}</p>
  </div>
</details>
