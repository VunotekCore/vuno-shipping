---
import ScrollReveal from '../atoms/ScrollReveal.astro';

interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;

import Icon from '../atoms/Icon.astro';
---

<ScrollReveal>
  <article class="bg-white border border-outline-variant rounded-xl p-sp-lg flex gap-sp-md hover:shadow-md transition-shadow group">
    <div class="w-16 h-16 bg-surface-container-high rounded-xl flex items-center justify-center shrink-0 group-hover:bg-primary-container transition-colors">
      <Icon name={icon} size="lg" class="fill-primary" />
    </div>
    <div>
      <h3 class="font-headline-md text-headline-md text-primary mb-sp-xs">{title}</h3>
      <p class="text-on-surface-variant">{description}</p>
    </div>
  </article>
</ScrollReveal>
