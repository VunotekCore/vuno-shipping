---
interface Props {
  title: string;
  description?: string;
  centered?: boolean;
  class?: string;
}

const { title, description, centered = true, class: className = '' } = Astro.props;

const headerClass = centered
  ? `mb-sp-xl text-center ${className}`
  : `mb-sp-xl text-center md:text-left ${className}`;
---

<header class={headerClass}>
  <h1 class="font-headline-lg text-headline-lg md:text-display-lg text-primary mb-sp-xs">{title}</h1>
  {description && (
    <p class:list={[
      'font-body-lg text-body-lg text-on-surface-variant max-w-2xl',
      centered && 'mx-auto',
    ]}>
      {description}
    </p>
  )}
  <slot />
</header>
