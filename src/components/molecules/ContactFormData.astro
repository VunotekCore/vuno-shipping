---
import FormField from './FormField.astro';
import Input from '../atoms/Input.astro';
import Textarea from '../atoms/Textarea.astro';
import Button from '../atoms/Button.astro';
import ScrollReveal from '../atoms/ScrollReveal.astro';
import Icon from '../atoms/Icon.astro';
---

<ScrollReveal>
  <div class="bg-white p-sp-lg rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.05)]">
    <h2 class="font-headline-md text-headline-md text-primary mb-sp-lg flex items-center gap-sp-xs">
      <Icon name="email" size="md" class="fill-primary" />
      Envíanos un Mensaje
    </h2>
    <form class="space-y-sp-md" id="contact-form">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-sp-md">
        <FormField label="Nombre" for="contact-name" required>
          <Input name="name" id="contact-name" placeholder="Tu nombre completo" required />
        </FormField>
        <FormField label="Correo Electrónico" for="contact-email" required>
          <Input type="email" name="email" id="contact-email" placeholder="correo@ejemplo.com" required />
        </FormField>
      </div>
      <FormField label="Número de WhatsApp" for="contact-phone">
        <Input type="tel" name="phone" id="contact-phone" placeholder="+505 0000-0000" />
      </FormField>
      <FormField label="Mensaje" for="contact-message" required>
        <Textarea name="message" id="contact-message" placeholder="¿Cómo podemos ayudarte?" rows={4} required />
      </FormField>
      <Button type="submit" variant="primary" fullWidth id="contact-submit">
        Enviar Mensaje
      </Button>
    </form>
  </div>
</ScrollReveal>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('contact-submit') as HTMLButtonElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const originalText = btn.innerText;
    btn.disabled = true;
    btn.innerText = 'Enviando...';
    btn.classList.add('opacity-70');

    setTimeout(() => {
      btn.innerText = '¡Mensaje Enviado!';
      btn.classList.remove('bg-primary');
      btn.classList.add('bg-secondary-container');

      setTimeout(() => {
        btn.innerText = originalText;
        btn.classList.remove('bg-secondary-container', 'opacity-70');
        btn.classList.add('bg-primary');
        btn.disabled = false;
        form?.reset();
      }, 2000);
    }, 1500);
  });
</script>
