---
import ScrollReveal from '../ui/ScrollReveal.astro';
---

<div class="bg-surface-container py-sp-lg border-t border-outline-variant">
  <ScrollReveal>
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-sp-xl flex flex-col items-center gap-sp-md">
      <span class="text-label-md text-outline uppercase tracking-widest">Connect With Us</span>
      <div class="flex gap-sp-lg">
        <a class="group no-underline" href="#">
          <div class="w-12 h-12 rounded-full border border-primary flex items-center justify-center group-hover:bg-primary transition-all">
            <span class="text-primary group-hover:text-white transition-colors text-label-md font-bold">FB</span>
          </div>
        </a>
        <a class="group no-underline" href="#">
          <div class="w-12 h-12 rounded-full border border-primary flex items-center justify-center group-hover:bg-primary transition-all">
            <span class="text-primary group-hover:text-white transition-colors text-label-md font-bold">IG</span>
          </div>
        </a>
        <a class="group no-underline" href="#">
          <div class="w-12 h-12 rounded-full border border-primary flex items-center justify-center group-hover:bg-primary transition-all">
            <span class="text-primary group-hover:text-white transition-colors text-label-md font-bold">TK</span>
          </div>
        </a>
      </div>
    </div>
  </ScrollReveal>
</div>
