    <div class="bg-surface-container-high p-sp-lg rounded-xl border border-outline-variant flex flex-col md:flex-row gap-sp-md">
      <div class="w-full md:w-32 h-32 bg-white rounded-lg overflow-hidden flex-shrink-0">
        <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCdTsqinN1b61Tlo8sIibGBQM8ELi2QHdmQRsqWdQkLsoZj8TdoDbuiuSIplgvFeNElcVc3UwllTtrJhIVnqft1DHrV5bxcCH9FAZTvU1SL8hELjJ2Uu-pRCMzl7TbhwI73You7LDv4mTiC5kXRHEIbD79Eh6AWKyiXb3BevsOKp2hs6MMXGp5HdaGALyidFMN-ItyVO8wpQcWgBOQX68Zsq9U3ErAdu6yAfn1faJC6TIVgjKlaI3PMH_Ag4OVshldUJfYXoDiwTqg" alt="Miami Warehouse" />
      </div>
      <div>
