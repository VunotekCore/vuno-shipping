---
import ScrollReveal from '../ui/ScrollReveal.astro';
---

<section class="lg:col-span-12 xl:col-span-8">
  <ScrollReveal>
    <div class="bg-white p-sp-lg rounded-xl border border-outline-variant shadow-[0px_4px_20px_rgba(0,0,0,0.05)] hover:shadow-[0px_6px_24px_rgba(0,0,0,0.10)] transition-all duration-300 transform hover:-translate-y-0.5">
      <div class="flex flex-col md:flex-row md:items-center justify-between mb-sp-md gap-sp-sm">
        <div>
          <h2 class="font-headline-md text-headline-md text-primary flex items-center gap-sp-xs">
            <svg class="w-7 h-7 fill-primary" viewBox="0 0 24 24"><path d="M18 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm1.5-9l1.96 2.5H17V9.5h2.5zm-8.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 12V9h3v3H5zm5 0V7h3v5h-3zm0-6V4h3v2h-3zm5 6v-4h3l2 4h-5z"/></svg>
            Package Tracking
          </h2>
          <p class="text-label-md text-outline">Enter your tracking number provided at drop-off.</p>
        </div>
      </div>
      <form class="flex flex-col md:flex-row gap-base" id="tracking-form">
        <div class="relative flex-grow">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 fill-outline" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          <input id="tracking-input" class="w-full pl-12 pr-4 py-4 rounded-lg border border-outline-variant bg-white focus:ring-2 focus:ring-primary-container focus:outline-none text-body-md transition-all" placeholder="e.g. MG-8829-NI" type="text" />
        </div>
        <button class="bg-secondary-container text-on-secondary-container px-sp-lg py-4 rounded-lg font-label-md hover:bg-secondary transition-colors uppercase tracking-wider flex items-center justify-center gap-sp-sm cursor-pointer" type="submit">
          Consultar
        </button>
      </form>

      <div id="tracking-result" class="mt-sp-lg p-sp-md bg-surface-container-low rounded-lg border border-surface-variant hidden">
        <div class="flex items-center gap-sp-md mb-sp-base">
          <div class="w-2 h-2 rounded-full bg-secondary-container"></div>
          <span class="text-label-sm uppercase tracking-tighter text-outline" id="tracking-status">Recent Activity</span>
        </div>
        <div class="flex flex-col gap-sp-sm">
          <div class="flex justify-between items-center">
            <span class="text-body-md font-bold" id="tracking-location">Miami Warehouse</span>
            <span class="text-label-sm" id="tracking-stage">Processing</span>
          </div>
          <div class="w-full h-1 bg-outline-variant rounded-full overflow-hidden">
            <div class="w-1/3 h-full bg-secondary-container" id="tracking-bar"></div>
          </div>
        </div>
      </div>

      <div id="tracking-placeholder" class="mt-sp-lg p-sp-md bg-surface-container-low rounded-lg border border-surface-variant">
        <div class="flex items-center gap-sp-md mb-sp-base">
          <div class="w-2 h-2 rounded-full bg-secondary-container"></div>
          <span class="text-label-sm uppercase tracking-tighter text-outline">Recent Activity</span>
        </div>
        <div class="flex flex-col gap-sp-sm">
          <div class="flex justify-between items-center opacity-60">
            <span class="text-body-md font-bold">Miami Warehouse</span>
            <span class="text-label-sm">Processing</span>
          </div>
          <div class="w-full h-1 bg-outline-variant rounded-full overflow-hidden">
            <div class="w-1/3 h-full bg-secondary-container"></div>
          </div>
        </div>
      </div>
    </div>
  </ScrollReveal>
</section>

<script>
  document.getElementById('tracking-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('tracking-input') as HTMLInputElement;
    const placeholder = document.getElementById('tracking-placeholder');
    const result = document.getElementById('tracking-result');
    if (!input?.value.trim()) {
      alert('Please enter a tracking number.');
      return;
    }
    placeholder?.classList.add('hidden');
    result?.classList.remove('hidden');
  });
</script>
