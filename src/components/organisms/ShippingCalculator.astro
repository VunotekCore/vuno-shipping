---
import ScrollReveal from '../atoms/ScrollReveal.astro';
import Input from '../atoms/Input.astro';
import Select from '../atoms/Select.astro';
import Button from '../atoms/Button.astro';
---

<section class="py-sp-xl px-margin-mobile md:px-sp-xl bg-surface-container-low" aria-label="Calculadora de envío">
  <ScrollReveal>
    <div class="max-w-container-max mx-auto">
      <div class="max-w-lg mx-auto bg-white border border-outline-variant rounded-xl p-sp-lg shadow-sm">
        <h2 class="font-headline-md text-headline-md text-primary mb-sp-md text-center">Calculadora de Envío</h2>
        <div class="space-y-sp-sm">
          <div>
            <label class="text-label-sm font-label-sm text-outline block mb-sp-xs" for="calc-weight">Peso (Lbs)</label>
            <Input id="calc-weight" type="number" placeholder="0.00" min="0" step="0.01" />
          </div>
          <div>
            <label class="text-label-sm font-label-sm text-outline block mb-sp-xs" for="calc-type">Tipo de Artículo</label>
            <Select id="calc-type">
              <option value="0">Ropa y Calzado</option>
              <option value="1">Electrónicos</option>
              <option value="2">Hogar</option>
            </Select>
          </div>
          <div>
            <label class="text-label-sm font-label-sm text-outline block mb-sp-xs" for="calc-mode">Tipo de Envío</label>
            <Select id="calc-mode">
              <option value="air">Courier Aéreo ($8.99/lb)</option>
              <option value="sea">Courier Marítimo ($4.99/lb)</option>
            </Select>
          </div>
          <Button id="calc-btn" variant="primary" fullWidth>Calcular Tarifa</Button>
          <div id="calc-result" class="mt-sp-md p-sp-md bg-surface-container-low rounded-xl border border-outline-variant hidden">
            <span class="text-label-sm text-outline">Tarifa estimada:</span>
            <p id="calc-price" class="text-headline-md font-headline-md text-primary mt-sp-xs">$0.00</p>
            <p class="text-label-sm text-outline">*Los precios pueden variar según el volumen y el valor declarado.</p>
          </div>
        </div>
      </div>
    </div>
  </ScrollReveal>
</section>

<script>
  const weightInput = document.getElementById('calc-weight') as HTMLInputElement;
  const typeSelect = document.getElementById('calc-type') as HTMLSelectElement;
  const modeSelect = document.getElementById('calc-mode') as HTMLSelectElement;
  const calcBtn = document.getElementById('calc-btn');
  const resultDiv = document.getElementById('calc-result');
  const priceSpan = document.getElementById('calc-price');

  const rates = { air: 8.99, sea: 4.99 };
  const multipliers = [1, 1.3, 1.15];

  calcBtn?.addEventListener('click', () => {
    const weight = parseFloat(weightInput?.value || '0');
    const type = parseInt(typeSelect?.value || '0');
    const mode = (modeSelect?.value || 'air') as 'air' | 'sea';
    if (weight <= 0) {
      if (priceSpan) {
        priceSpan.textContent = 'Ingresa un peso válido';
        priceSpan.classList.add('text-error');
        priceSpan.classList.remove('text-primary');
      }
      resultDiv?.classList.remove('hidden');
      return;
    }
    if (priceSpan) {
      priceSpan.classList.remove('text-error');
      priceSpan.classList.add('text-primary');
    }
    const base = rates[mode];
    const mult = multipliers[type] || 1;
    const total = weight * base * mult;
    resultDiv?.classList.remove('hidden');
    if (priceSpan) {
      priceSpan.textContent = `$${total.toFixed(2)} USD`;
    }
  });
</script>
