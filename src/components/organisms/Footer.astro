---
import CopyrightBar from '../molecules/CopyrightBar.astro';
import Icon from '../atoms/Icon.astro';
import { navLinks } from '../../lib/nav';

const companyLinks = [
  { href: '/privacidad', label: 'Política de Privacidad' },
  { href: '/terminos', label: 'Términos de Servicio' },
];

const serviceLinks = [
  { href: '/servicios', label: 'Nuestros Servicios' },
  { href: '/faq', label: 'Preguntas Frecuentes' },
  { href: '/rastreo', label: 'Rastrear Paquete' },
];
---

<footer class="w-full bg-primary">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-sp-xl py-sp-lg grid grid-cols-1 md:grid-cols-3 gap-sp-lg">
    <div class="flex flex-col gap-sp-sm">
      <span class="text-headline-md font-headline-md font-bold text-on-primary">Shipping Agency</span>
      <p class="text-primary-fixed-dim max-w-xs text-body-md font-body-md">Llevando el mundo a tus manos. Especialistas en logística Miami-Nicaragua.</p>
      <div class="flex gap-sp-md mt-base">
        <a class="text-primary-fixed-dim hover:text-white transition-colors" href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <Icon name="facebook" size="sm" class="fill-current" />
        </a>
        <a class="text-primary-fixed-dim hover:text-white transition-colors" href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <Icon name="instagram" size="sm" class="fill-current" />
        </a>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-sp-lg">
      <div class="flex flex-col gap-sp-sm">
        <p class="text-on-primary font-bold text-label-md">Navegación</p>
        {navLinks.slice(0, 3).map((link) => (
          <a class="text-primary-fixed-dim text-label-sm font-label-sm hover:text-white transition-colors no-underline" href={link.href}>{link.label}</a>
        ))}
      </div>
      <div class="flex flex-col gap-sp-sm">
        <p class="text-on-primary font-bold text-label-md invisible">Navegación</p>
        {navLinks.slice(3).map((link) => (
          <a class="text-primary-fixed-dim text-label-sm font-label-sm hover:text-white transition-colors no-underline" href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-2 gap-sp-lg">
      <div class="flex flex-col gap-sp-sm">
        <p class="text-on-primary font-bold text-label-md">Compañía</p>
        {companyLinks.map((link) => (
          <a class="text-primary-fixed-dim text-label-sm font-label-sm hover:text-white transition-colors no-underline" href={link.href}>{link.label}</a>
        ))}
      </div>
      <div class="flex flex-col gap-sp-sm">
        <p class="text-on-primary font-bold text-label-md">Servicios</p>
        {serviceLinks.map((link) => (
          <a class="text-primary-fixed-dim text-label-sm font-label-sm hover:text-white transition-colors no-underline" href={link.href}>{link.label}</a>
        ))}
      </div>
    </div>
  </div>

  <CopyrightBar />
</footer>
