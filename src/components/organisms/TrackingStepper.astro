---
const steps = [
  { icon: 'inventory', label: 'Recibido en Miami' },
  { icon: 'document', label: 'Aduana Nicaragua' },
  { icon: 'shipping', label: 'En Ruta de Entrega' },
  { icon: 'check', label: 'Entregado' },
];

const iconPaths: Record<string, string> = {
  inventory: 'M17 4V2H7v2H2v7c0 1.1.9 2 2 2h3.1c.28 1.14 1.3 2 2.6 2h2.6c1.3 0 2.32-.86 2.6-2H20c1.1 0 2-.9 2-2V4h-5zM7 6h10v3H7V6zm12 5h-3.1c-.28-1.14-1.3-2-2.6-2h-2.6c-1.3 0-2.32.86-2.6 2H5V6h2v3h10V6h2v5z',
  document: 'M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z',
  shipping: 'M6 22q-1.05 0-1.775-.725Q3.5 20.55 3.5 19.5H2V3q0-.825.588-1.413Q3.175 1 4 1h11q.825 0 1.413.587Q17 2.175 17 3v3h3l3 4v9h-1.5q0 1.05-.725 1.775Q19.05 22 18 22q-1.05 0-1.775-.725Q15.5 20.55 15.5 19.5h-5q0 1.05-.725 1.775Q9.05 22 8 22q-1.05 0-1.775-.725Q5.5 20.55 5.5 19.5H5v-2h12v-7H5V5h9V3H4v14.025q.45-.275.95-.4Q5.45 16.5 6 16.5q1.05 0 1.775.725Q8.5 17.95 8.5 19q0 .425-.15.825-.15.4-.35.675.2.275.35.675.15.4.15.825 0 .45-.15.825-.15.375-.35.675.2.275.35.675.15.4.15.825 0 1.05-.725 1.775Q7.05 22 6 22Z',
  check: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z',
};
---

<section class="py-sp-lg px-margin-mobile md:px-sp-xl bg-white border-y border-outline-variant" aria-label="Estados de rastreo">
  <div class="max-w-container-max mx-auto overflow-x-auto" data-stepper-reveal>
    <div class="flex items-center justify-between min-w-[800px] py-sp-md">
      {steps.map((step, i) => (
        <>
          <div class="flex flex-col items-center gap-base stepper-step" data-step={i} style={`animation-delay: ${i * 800}ms`}>
            <div class="w-12 h-12 rounded-full flex items-center justify-center step-circle">
              <svg class="w-6 h-6 step-icon" viewBox="0 0 24 24"><path d={iconPaths[step.icon]} /></svg>
              <svg class="w-6 h-6 step-icon-check hidden" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            </div>
            <span class="text-label-md font-bold whitespace-nowrap step-label">{step.label}</span>
          </div>
          {i < steps.length - 1 && (
            <div class="flex-1 h-1 mx-sp-base relative stepper-line stepper-line-connector" data-line={i} style={`animation-delay: ${i * 800 + 400}ms`}>
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                <svg class="w-4 h-4 fill-secondary-container" viewBox="0 0 24 24"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
              </div>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes stepperFadeIn {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes stepperLineReveal {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes stepperPulse {
    0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-secondary-container), transparent 40%); }
    50% { box-shadow: 0 0 0 12px color-mix(in srgb, var(--color-secondary-container), transparent 100%); }
  }
  @keyframes lineFill {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  .stepper-step { opacity: 0; animation: stepperFadeIn 0.6s ease forwards; animation-play-state: paused; }
  .stepper-line { animation: stepperLineReveal 0.6s ease forwards; animation-play-state: paused; }
  .stepper-pulse { animation: stepperPulse 2s ease infinite; }
  .stepper-revealed .stepper-step,
  .stepper-revealed .stepper-line { animation-play-state: running; }
  .stepper-line-connector { transition: background-color 0.6s ease; }
  .line-fill { clip-path: inset(0 100% 0 0); animation: lineFill 0.6s ease forwards; }
  .step-circle { transition: background-color 0.5s ease; }
  .step-icon, .step-icon-check { transition: fill 0.3s ease; }
  .step-label { transition: color 0.3s ease; }
</style>

<script>
  const container = document.querySelector('[data-stepper-reveal]');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('stepper-revealed');
        revealObserver.unobserve(entry.target);
        startProgression(entry.target);
      }
    });
  }, { threshold: 0.15 });
  if (container) revealObserver.observe(container);

  function startProgression(parent) {
    const stepEls = parent.querySelectorAll('[data-step]');
    const lineEls = parent.querySelectorAll('[data-line]');
    const ENTRANCE_WAIT = 3800;
    const STEP_INTERVAL = 3000;
    const LOOP_PAUSE = 3000;
    let currentStep = 0;

    function advance() {
      if (currentStep >= stepEls.length - 1) {
        completeLast(stepEls[currentStep]);
        setTimeout(loopReset, LOOP_PAUSE);
        return;
      }
      completeStep(stepEls[currentStep]);
      const nextStep = currentStep + 1;
      activateStep(stepEls[nextStep]);
      if (lineEls[currentStep]) fillLine(lineEls[currentStep]);
      currentStep = nextStep;
      setTimeout(advance, STEP_INTERVAL);
    }

    function loopReset() {
      stepEls.forEach((el, i) => {
        const circle = el.querySelector('.step-circle');
        const icon = el.querySelector('.step-icon');
        const iconCheck = el.querySelector('.step-icon-check');
        const label = el.querySelector('.step-label');
        circle?.classList.remove('bg-primary', 'stepper-pulse', 'bg-secondary-container');
        icon?.classList.remove('hidden', 'fill-on-secondary-container');
        iconCheck?.classList.add('hidden');
        iconCheck?.classList.remove('fill-white');
        label?.classList.remove('text-primary', 'text-on-surface-variant');
        if (i === 0) {
          circle?.classList.add('bg-secondary-container', 'stepper-pulse');
          icon?.classList.add('fill-on-secondary-container');
          label?.classList.add('text-primary');
        } else {
          circle?.classList.add('border-2', 'border-outline-variant');
          icon?.classList.add('fill-outline');
          label?.classList.add('text-on-surface-variant');
        }
      });
      lineEls.forEach((el) => {
        el.classList.remove('bg-secondary-container', 'line-fill');
        el.classList.add('bg-outline-variant');
        el.style.clipPath = '';
      });
      currentStep = 0;
      setTimeout(advance, 1000);
    }

    setTimeout(() => { advance(); }, ENTRANCE_WAIT);
  }

  function completeStep(el) {
    const circle = el.querySelector('.step-circle');
    const icon = el.querySelector('.step-icon');
    const iconCheck = el.querySelector('.step-icon-check');
    const label = el.querySelector('.step-label');
    el.classList.remove('stepper-pulse');
    circle?.classList.remove('stepper-pulse', 'bg-secondary-container');
    circle?.classList.add('bg-primary');
    icon?.classList.add('hidden');
    iconCheck?.classList.remove('hidden');
    iconCheck?.classList.add('fill-white');
    label?.classList.add('text-primary');
  }

  function activateStep(el) {
    const circle = el.querySelector('.step-circle');
    const icon = el.querySelector('.step-icon');
    const iconCheck = el.querySelector('.step-icon-check');
    const label = el.querySelector('.step-label');
    circle?.classList.remove('border-2', 'border-outline-variant');
    circle?.classList.add('bg-secondary-container', 'stepper-pulse');
    icon?.classList.remove('fill-outline', 'hidden');
    icon?.classList.add('fill-on-secondary-container');
    iconCheck?.classList.add('hidden');
    iconCheck?.classList.remove('fill-white');
    label?.classList.remove('text-on-surface-variant');
    label?.classList.add('text-primary');
  }

  function completeLast(el) {
    const circle = el.querySelector('.step-circle');
    const icon = el.querySelector('.step-icon');
    const iconCheck = el.querySelector('.step-icon-check');
    const label = el.querySelector('.step-label');
    el.classList.remove('stepper-pulse');
    circle?.classList.remove('stepper-pulse', 'bg-secondary-container');
    circle?.classList.add('bg-primary');
    icon?.classList.add('hidden');
    iconCheck?.classList.remove('hidden');
    iconCheck?.classList.add('fill-white');
    label?.classList.add('text-primary');
  }

  function fillLine(el) {
    el.classList.remove('bg-outline-variant');
    el.classList.add('bg-secondary-container');
    el.classList.remove('line-fill');
    void el.offsetWidth;
    el.classList.add('line-fill');
  }
</script>
