---
import Icon from '../atoms/Icon.astro';

const whatsappNumber = '1234567890';
---

<a
  class="fixed bottom-2 right-margin-mobile z-50 whatsapp-pulse bg-[#25D366] text-white p-2.5 rounded-full shadow-2xl flex items-center justify-center transition-transform hover:scale-110 active:scale-95 md:bottom-14"
  href={`https://wa.me/${whatsappNumber}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chatea con nosotros en WhatsApp"
>
  <Icon name="whatsapp" size="md" class="fill-current" />
</a>
