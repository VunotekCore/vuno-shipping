---
import StepCard from '../molecules/StepCard.astro';

const steps = [
  {
    number: 'PASO 01',
    icon: 'shopping_cart',
    title: 'Compra en tus tiendas favoritas',
    description: 'Amazon, eBay, Shein o cualquier tienda en USA. Al finalizar tu compra, usa tu dirección de casillero Shipping Agency.',
  },
  {
    number: 'PASO 02',
    icon: 'warehouse',
    title: 'Envía a nuestro almacén en Miami',
    description: 'Recibimos tus paquetes, los procesamos con cuidado y te notificamos de inmediato en tu panel de usuario.',
  },
  {
    number: 'PASO 03',
    icon: 'door_front',
    title: 'Recibe en tu puerta',
    description: 'Consolidamos y despachamos hacia Nicaragua. Disfruta de la comodidad de la entrega a domicilio en todo el país.',
  },
];
---

<section id="proceso" class="py-sp-xl px-margin-mobile md:px-sp-xl bg-surface-container-low" aria-label="Cómo funciona">
  <div class="max-w-container-max mx-auto">
    <header class="text-center mb-sp-lg">
      <h2 class="font-headline-lg text-headline-lg text-primary mb-base">¿Cómo funciona?</h2>
      <p class="text-on-surface-variant font-body-lg max-w-2xl mx-auto">Importar de Estados Unidos a Nicaragua nunca fue tan sencillo. Sigue estos tres pasos.</p>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-sp-lg relative">
      <div class="hidden md:block absolute top-1/2 left-0 w-full h-0.5 bg-secondary/20 -translate-y-1/2 z-0" aria-hidden="true"></div>
      {steps.map((step) => (
        <StepCard
          number={step.number}
          icon={step.icon}
          title={step.title}
          description={step.description}
        />
      ))}
    </div>
  </div>
</section>
