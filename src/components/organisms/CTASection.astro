---
import ScrollReveal from '../atoms/ScrollReveal.astro';
import Button from '../atoms/Button.astro';
---

<section class="py-sp-xl px-margin-mobile md:px-sp-xl" aria-label="Llamada a la acción">
  <ScrollReveal>
    <div class="max-w-4xl mx-auto bg-primary rounded-2xl p-sp-xl text-center relative overflow-hidden">
      <div class="relative z-10">
        <h2 class="font-display-lg text-display-lg text-on-primary mb-sp-md">¿Listo para empezar a comprar?</h2>
        <p class="text-on-primary/80 text-body-lg mb-sp-lg max-w-xl mx-auto">
          Regístrate hoy mismo y obtén tu dirección física en Miami totalmente gratis. Sin membresías mensuales.
        </p>
        <Button variant="secondary" size="lg" href="/rastreo">Crear mi Cuenta Gratis</Button>
      </div>
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-on-primary/5 rounded-full" aria-hidden="true"></div>
      <div class="absolute -bottom-12 -left-12 w-48 h-48 bg-secondary/10 rounded-full" aria-hidden="true"></div>
    </div>
  </ScrollReveal>
</section>
