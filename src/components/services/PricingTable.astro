---
import ScrollReveal from '../ui/ScrollReveal.astro';
---

<section class="py-sp-xl px-margin-mobile md:px-sp-xl">
  <ScrollReveal>
    <div class="max-w-container-max mx-auto">
      <h2 class="font-headline-lg text-headline-lg text-primary mb-sp-lg text-center">Comparativa de Envío</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-sp-md">
        <div class="bg-white border border-outline-variant rounded-xl p-sp-lg text-center hover:shadow-md transition-shadow">
          <span class="bg-surface-container-high text-label-sm font-label-sm px-base py-sp-xs rounded-full mb-sp-md inline-block">Básico</span>
          <h3 class="font-headline-md text-headline-md text-primary mb-sp-sm">Recogida en Agencia</h3>
          <p class="text-display-lg font-display-lg text-primary mb-sp-xs">$4.99</p>
          <p class="text-label-sm text-outline mb-sp-md">por libra (marítimo)</p>
          <ul class="text-left space-y-sp-sm mb-sp-lg">
            <li class="flex items-center gap-sp-xs text-body-md">
              <svg class="w-5 h-5 fill-secondary-container shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Recogida en Managua
            </li>
            <li class="flex items-center gap-sp-xs text-body-md">
              <svg class="w-5 h-5 fill-secondary-container shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              7-10 días hábiles
            </li>
            <li class="flex items-center gap-sp-xs text-body-md">
              <svg class="w-5 h-5 fill-secondary-container shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Seguro opcional
            </li>
          </ul>
          <button class="w-full border-2 border-primary text-primary py-base rounded-lg font-label-md hover:bg-primary hover:text-on-primary transition-all cursor-pointer">Elegir Plan</button>
        </div>

        <div class="bg-primary text-on-primary rounded-xl p-sp-lg text-center relative scale-105 shadow-lg border-2 border-secondary-container">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-secondary-container text-on-secondary-container text-label-sm font-label-sm px-sp-md py-sp-xs rounded-full">Más Popular</span>
          <span class="bg-white/20 text-label-sm font-label-sm px-base py-sp-xs rounded-full mb-sp-md inline-block">Estándar</span>
          <h3 class="font-headline-md text-headline-md mb-sp-sm">Entrega a Domicilio</h3>
          <p class="text-display-lg font-display-lg mb-sp-xs">$8.99</p>
          <p class="text-on-primary/70 text-label-sm mb-sp-md">por libra (aéreo)</p>
          <ul class="text-left space-y-sp-sm mb-sp-lg">
            <li class="flex items-center gap-sp-xs text-body-md">
              <svg class="w-5 h-5 fill-secondary-container shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Entrega puerta a puerta
            </li>
            <li class="flex items-center gap-sp-xs text-body-md">
              <svg class="w-5 h-5 fill-secondary-container shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              3-5 días hábiles
            </li>
            <li class="flex items-center gap-sp-xs text-body-md">
              <svg class="w-5 h-5 fill-secondary-container shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Seguro incluido
            </li>
          </ul>
          <button class="w-full bg-on-primary text-primary py-base rounded-lg font-label-md hover:bg-secondary-container hover:text-on-secondary-container transition-all cursor-pointer">Elegir Plan</button>
        </div>

        <div class="bg-white border border-outline-variant rounded-xl p-sp-lg text-center hover:shadow-md transition-shadow">
          <span class="bg-surface-container-high text-label-sm font-label-sm px-base py-sp-xs rounded-full mb-sp-md inline-block">Premium</span>
          <h3 class="font-headline-md text-headline-md text-primary mb-sp-sm">Carga Voluminosa</h3>
          <p class="text-display-lg font-display-lg text-primary mb-sp-xs">$2.99</p>
          <p class="text-label-sm text-outline mb-sp-md">por libra (marítimo, +50lbs)</p>
          <ul class="text-left space-y-sp-sm mb-sp-lg">
            <li class="flex items-center gap-sp-xs text-body-md">
              <svg class="w-5 h-5 fill-secondary-container shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Ideal para mudanzas
            </li>
            <li class="flex items-center gap-sp-xs text-body-md">
              <svg class="w-5 h-5 fill-secondary-container shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              10-15 días hábiles
            </li>
            <li class="flex items-center gap-sp-xs text-body-md">
              <svg class="w-5 h-5 fill-secondary-container shrink-0" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Seguro incluido
            </li>
          </ul>
          <button class="w-full border-2 border-primary text-primary py-base rounded-lg font-label-md hover:bg-primary hover:text-on-primary transition-all cursor-pointer">Elegir Plan</button>
        </div>
      </div>
    </div>
  </ScrollReveal>
</section>
