---
import ScrollReveal from '../ui/ScrollReveal.astro';

const services = [
  {
    icon: 'inbox',
    title: 'Casillero Virtual en Miami',
    desc: 'Recibe tus compras de Amazon, eBay, Shein y más en nuestra dirección física en Miami. Te notificamos cuando llegue cada paquete.'
  },
  {
    icon: 'rocket_launch',
    title: 'Courier Aéreo',
    desc: 'Envíos exprés vía aérea con llegada a Nicaragua en 3-5 días hábiles. Ideal para paquetes urgentes y de alto valor.'
  },
  {
    icon: 'directions_boat',
    title: 'Courier Marítimo',
    desc: 'Para cargas grandes y mudanzas. Consolidamos tu mercancía y la enviamos por vía marítima con la mejor relación costo-beneficio.'
  },
  {
    icon: 'verified',
    title: 'Seguro de Carga',
    desc: 'Protege tus envíos con nuestro seguro opcional. Cobertura completa desde Miami hasta la entrega final en Nicaragua.'
  }
];

const iconPaths: Record<string, string> = {
  inbox: 'M19 3H4.99c-1.11 0-1.98.89-1.98 2L3 19c0 1.1.88 2 1.99 2H19c1.1 0 2-.9 2-2V5c0-1.11-.9-2-2-2zm0 12h-4c0 1.66-1.35 3-3 3s-3-1.34-3-3H4.99V5H19v10z',
  rocket_launch: 'M9 19c-2.2 0-4-1.8-4-4 0-2.2 1.8-4 4-4 2.2 0 4 1.8 4 4 0 2.2-1.8 4-4 4zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm7-11c-1.1 0-2 .9-2 2v1H8V4c0-1.1-.9-2-2-2s-2 .9-2 2v1H1v15h20V5h-3V4c0-1.1-.9-2-2-2zM5 18h14V7H5v11z',
  directions_boat: 'M20 21c-1.39 0-2.78-.47-4-1.32-2.44 1.71-5.56 1.71-8 0C6.78 20.53 5.39 21 4 21H2v2h2c1.38 0 2.74-.35 4-.99 2.52 1.29 5.48 1.29 8 0 1.26.65 2.62.99 4 .99h2v-2h-2zM3.95 19H4c1.6 0 3.02-.88 4-2 1.98 2.34 6.02 2.34 8 0 .98 1.12 2.4 2 4 2h.05l1.89-6.68c.08-.26.06-.54-.06-.78s-.34-.42-.6-.5L20 10.62V6c0-1.1-.9-2-2-2h-3V2c0-.55-.45-1-1-1h-4c-.55 0-1 .45-1 1v2H6c-1.1 0-2 .9-2 2v4.62l-1.29.42c-.26.08-.48.26-.6.5s-.15.52-.06.78L3.95 19zM6 6h12v3.97L12 8 6 9.97V6z',
  verified: 'M23 12l-2.44-2.79.34-3.69-3.61-.82-1.89-3.2L12 2.96 8.6 1.5 6.71 4.69 3.1 5.5l.34 3.7L1 12l2.44 2.79-.34 3.7 3.61.82L8.6 22.5l3.4-1.47 3.4 1.46 1.89-3.19 3.61-.82-.34-3.69L23 12zm-12.91 4.72l-3.8-3.81 1.48-1.48 2.32 2.33 5.84-5.84 1.48 1.48-7.32 7.32z'
};
---

<section class="py-sp-xl px-margin-mobile md:px-sp-xl">
  <div class="max-w-container-max mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-sp-md">
      {
        services.map((svc) => (
          <ScrollReveal>
            <div class="bg-white border border-outline-variant rounded-xl p-sp-lg flex gap-sp-md hover:shadow-md transition-shadow group">
              <div class="w-16 h-16 bg-surface-container-high rounded-xl flex items-center justify-center shrink-0 group-hover:bg-primary-container transition-colors">
                <svg class="w-8 h-8 fill-primary" viewBox="0 0 24 24"><path d={iconPaths[svc.icon]} /></svg>
              </div>
              <div>
                <h3 class="font-headline-md text-headline-md text-primary mb-sp-xs">{svc.title}</h3>
                <p class="text-on-surface-variant">{svc.desc}</p>
              </div>
            </div>
          </ScrollReveal>
        ))
      }
    </div>
  </div>
</section>
