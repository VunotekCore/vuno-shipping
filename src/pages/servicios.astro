---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import WhatsAppButton from '../components/organisms/WhatsAppButton.astro';
import ServiceHero from '../components/organisms/ServiceHero.astro';
import ServiceCards from '../components/organisms/ServiceCards.astro';
import ShippingCalculator from '../components/organisms/ShippingCalculator.astro';
import PricingTable from '../components/organisms/PricingTable.astro';
---

<BaseLayout title="Servicios & Pricing | Shipping Agency">
  <Header activePage="servicios" />
  <main>
    <ServiceHero />
    <ServiceCards />
    <ShippingCalculator />
    <PricingTable />
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
