---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import WhatsAppButton from '../components/organisms/WhatsAppButton.astro';
import TrackingInput from '../components/molecules/TrackingInput.astro';
import Icon from '../components/atoms/Icon.astro';
import PageHeader from '../components/molecules/PageHeader.astro';
---

<BaseLayout title="Rastreo de Paquetes | Shipping Agency" description="Rastrea tu paquete en tiempo real desde Miami hasta Nicaragua. Ingresa tu número de tracking y conoce el estado de tu envío.">
  <Header activePage="rastreo" />
  <main id="main-content" class="pt-24 pb-xl px-margin-mobile md:px-sp-xl max-w-container-max mx-auto">
    <PageHeader
      title="Rastreo de Paquetes"
      description="Ingresa tu número de rastreo para conocer el estado actual de tu envío."
    />

    <section class="max-w-2xl mx-auto" aria-label="Formulario de rastreo">
      <TrackingInput />
    </section>

    <section class="max-w-3xl mx-auto mt-sp-xl">
      <h2 class="font-headline-md text-headline-md text-primary mb-sp-md text-center">Estados del Envío</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-sp-md text-center">
        <article class="bg-surface-container-low p-sp-md rounded-xl border border-outline-variant">
          <div class="w-10 h-10 bg-secondary-container rounded-full flex items-center justify-center mx-auto mb-sp-xs">
            <Icon name="inventory" size="sm" class="fill-on-secondary-container" />
          </div>
          <h3 class="text-label-md font-bold text-primary">Recibido en Miami</h3>
          <p class="text-label-sm text-outline">Tu compra llegó a nuestro almacén</p>
        </article>
        <article class="bg-surface-container-low p-sp-md rounded-xl border border-outline-variant">
          <div class="w-10 h-10 bg-secondary-container rounded-full flex items-center justify-center mx-auto mb-sp-xs">
            <Icon name="flight" size="sm" class="fill-on-secondary-container" />
          </div>
          <h3 class="text-label-md font-bold text-primary">En Tránsito a Nicaragua</h3>
          <p class="text-label-sm text-outline">Viajando, aduana incluida</p>
        </article>
        <article class="bg-surface-container-low p-sp-md rounded-xl border border-outline-variant">
          <div class="w-10 h-10 bg-secondary-container rounded-full flex items-center justify-center mx-auto mb-sp-xs">
            <Icon name="truck" size="sm" class="fill-on-secondary-container" />
          </div>
          <h3 class="text-label-md font-bold text-primary">En Ruta de Entrega</h3>
          <p class="text-label-sm text-outline">Recibido en Nicaragua, en camino a tu domicilio</p>
        </article>
        <article class="bg-surface-container-low p-sp-md rounded-xl border border-outline-variant">
          <div class="w-10 h-10 bg-secondary-container rounded-full flex items-center justify-center mx-auto mb-sp-xs">
            <Icon name="check_circle" size="sm" class="fill-on-secondary-container" />
          </div>
          <h3 class="text-label-md font-bold text-primary">Entregado</h3>
          <p class="text-label-sm text-outline">En tu puerta</p>
        </article>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
