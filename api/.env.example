# === Frontend (Astro) ===
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:8000/api

# === Backend PHP ===
DB_HOST=localhost
DB_NAME=vuno_db_shipping
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

JWT_SECRET=CHANGE_ME_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=86400
JWT_ISSUER=localhost

CORS_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173

APP_DEBUG=true
APP_TIMEZONE=America/Managua

# Comma-separated list of trusted proxy IPs.
# Only these IPs will have X-Forwarded-For / X-Real-IP headers honored.
# On shared hosting without reverse proxy: leave default (localhost only).
TRUSTED_PROXIES=127.0.0.1,::1
